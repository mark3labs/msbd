# Local development overrides for msbd.
#
# Copy this file to `.env` (gitignored) and edit to taste. The msbd binary
# loads `.env` from its working directory on startup via godotenv, so every
# launch path — `./bin/msbd serve`, `task dev`, `docker run`, the Nix module —
# picks up the same values without further plumbing.
#
# Precedence (highest wins):
#   1. --flag on the CLI                 (e.g. --api-key ...)
#   2. exported shell / Docker env var   (e.g. MSBD_API_KEY=x ./bin/msbd)
#   3. .env in the working directory     (this file, if renamed)
#   4. built-in defaults in the binary
#
# Every option below has a matching --flag; see `msbd serve --help` for the
# full surface. Uncomment and edit as needed.

# ---- API surface ------------------------------------------------------------

# Bearer token(s), comma-separated for rotation. Empty = unauthenticated
# (dev only — msbd logs a loud warning).
# MSBD_API_KEY=devkey

# Read the bearer token from a file instead of the env var (Docker/K8s
# secrets). Overrides MSBD_API_KEY when both are set.
# MSBD_API_KEY_FILE=/run/secrets/msbd-api-key

# HTTP listen address. Default :8099.
# MSBD_LISTEN=:8099

# ---- Dashboard --------------------------------------------------------------

# Serve the web dashboard at /dashboard. Default true.
# MSBD_DASHBOARD=true

# Dashboard HTTP Basic auth (both must be set to enable auth).
# MSBD_DASHBOARD_USER=admin
# MSBD_DASHBOARD_PASS=changeme

# Let the dashboard mount without auth even though an API key IS set — UNSAFE
# in prod (dashboard bypasses the API bearer token). Handy for local dev.
# MSBD_DASHBOARD_ALLOW_INSECURE=true

# ---- Runtime ----------------------------------------------------------------

# Default OCI image when create requests omit one.
# MSBD_DEFAULT_IMAGE=microsandbox/python

# Concurrency cap; 0 = unlimited.
# MSBD_MAX_SANDBOXES=0

# Timeouts (seconds).
# MSBD_CREATE_TIMEOUT_SECS=300
# MSBD_PULL_TIMEOUT_SECS=900
# MSBD_SHUTDOWN_TIMEOUT_SECS=60

# Async-job stdout/stderr ring buffer cap per stream (bytes); 0 = 1 MiB.
# MSBD_JOB_MAX_BYTES=0

# Finished-job retention before eviction (seconds); 0 = 15m.
# MSBD_JOB_TTL_SECS=0

# Allowlisted host path prefixes for /files/copy-from-host, copy-to-host, and
# snapshot export/import. Comma-separated. Empty = host transfers DENIED (403).
# MSBD_HOST_PATHS=/var/tmp/msbd,/data/inbox

# Log level: debug | info | warn | error.
# MSBD_LOG_LEVEL=info
