package views

import (
	"github.com/mark3labs/msbd/internal/dashboard/components/alertdialog"
	"github.com/mark3labs/msbd/internal/dashboard/components/button"
	"github.com/mark3labs/msbd/internal/dashboard/components/checkbox"
	"github.com/mark3labs/msbd/internal/dashboard/components/dialog"
	fieldcomp "github.com/mark3labs/msbd/internal/dashboard/components/field"
	"github.com/mark3labs/msbd/internal/dashboard/components/icon"
	"github.com/mark3labs/msbd/internal/dashboard/components/input"
	selectcomp "github.com/mark3labs/msbd/internal/dashboard/components/select"
	"github.com/mark3labs/msbd/internal/dashboard/components/textarea"
)

// dialogOpenButton renders a shadcn-templ dialog trigger styled as a primary button.
templ dialogOpenButton(forID, lbl string) {
	if CanAdmin(ctx) {
		@button.Button(button.Props{Size: button.SizeSm, Attributes: dialog.TriggerFor(forID)}) {
			@icon.Plus(icon.Props{Class: "size-4"})
			{ lbl }
		}
	}
}

// field composes the upstream field layout with an accessible label.
templ field(forID, lbl string) {
	@fieldcomp.Field() {
		@fieldcomp.Label(fieldcomp.LabelProps{For: forID}) {
			{ lbl }
		}
		{ children... }
	}
}

templ hint(text string) {
	@fieldcomp.Description() {
		{ text }
	}
}

templ selectField(forID, lbl, bind string, opts []string) {
	@field(forID, lbl) {
		@signalSelect(forID, bind, selectItems(opts), "Choose…")
	}
}

// signalSelect is controlled by Datastar, not the hidden form input. The
// cancelable select-change detail.value is the string requested by Base UI;
// data-effect commits server signal resets and selection changes via its API.
templ signalSelect(id, bind string, items []selectcomp.ItemData, placeholder string, options ...string) {
	{{ afterChange := "" }}
	if len(options) > 0 {
		{{ afterChange = options[0] }}
	}
	@selectcomp.Select(selectcomp.Props{ID: id + "-select", Value: stringPtr(""), Items: items}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{ID: id, Class: "w-full", Attributes: templ.Attributes{
			"data-on:select-change": selectChange(bind, afterChange),
			"data-effect":           "window.templ && window.templ.select && window.templ.select.setValue(el, $" + bind + ".toString())",
		}}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: placeholder})
		}
		@selectcomp.Content() {
			for _, item := range items {
				@selectcomp.Item(selectcomp.ItemProps{Value: item.Value, Label: item.Label.(string)}) {
					{ item.Label.(string) }
				}
			}
		}
	}
}

func stringPtr(s string) *string { return &s }

func selectItems(opts []string) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(opts))
	for _, o := range opts {
		items = append(items, selectcomp.ItemData{Value: o, Label: optionLabel(o)})
	}
	return items
}

func sandboxSelectItems(rows []SandboxRow) []selectcomp.ItemData {
	items := []selectcomp.ItemData{{Value: "", Label: "Select a sandbox…"}}
	for _, s := range rows {
		items = append(items, selectcomp.ItemData{Value: s.ID, Label: s.ID + " (" + s.State + ")"})
	}
	return items
}

func optionLabel(o string) string {
	if o == "" {
		return "(default)"
	}
	return o
}

// ---------------------------------------------------------------------------
// Confirm dialog
// ---------------------------------------------------------------------------

// ConfirmDialog is the single, styled replacement for window.confirm(). It is
// rendered once per page; callers arm it via @confirm(...) which fills the
// title/body signals and stashes the Datastar action to run on confirm.
//
// Signals: cfmtitle, cfmbody, cfmlabel, cfmdanger, cfmaction (a JS thunk).
templ ConfirmDialog() {
	if CanAdmin(ctx) {
		<div data-signals="{cfmtitle:'Are you sure?', cfmbody:'', cfmlabel:'Confirm', cfmdanger:true}">
			@alertdialog.AlertDialog(alertdialog.Props{ID: "confirm"}) {
				@alertdialog.Content(alertdialog.ContentProps{Class: "sm:max-w-md"}) {
					@alertdialog.Header() {
						@alertdialog.Title() {
							<span data-text="$cfmtitle"></span>
						}
						@alertdialog.Description() {
							<span class="break-words" data-text="$cfmbody"></span>
						}
					}
					@alertdialog.Footer() {
						@alertdialog.Cancel() {
							Cancel
						}
						@alertdialog.Action(alertdialog.ActionProps{ID: "confirm-go", Variant: button.VariantDestructive, Attributes: templ.Attributes{
							"data-text":     "$cfmlabel",
							"data-class":    "{'bg-destructive':$cfmdanger,'bg-primary':!$cfmdanger,'text-primary-foreground':!$cfmdanger}",
							"data-on:click": "window.__msbdConfirmRun && window.__msbdConfirmRun()",
						}})
					}
				}
			}
		</div>
	}
}

// confirmAction builds the data-on:click expression that opens the confirm
// dialog and, on approval, runs `action`.
//
// The action is stashed on window as a thunk rather than interpolated into the
// dialog markup, so guest-controlled names can never become executable text —
// they only ever flow through the (text-only) cfmbody signal.
func confirmAction(title, body, label, action string) string {
	return "$cfmtitle=" + jsExpr(title) +
		";$cfmbody=" + jsExpr(body) +
		";$cfmlabel=" + jsExpr(label) +
		";$cfmdanger=true" +
		";window.__msbdConfirmRun=()=>{window.templ.dialog.close('confirm');" + action + "}" +
		";window.templ.dialog.open('confirm')"
}

// ---------------------------------------------------------------------------
// Create sandbox
// ---------------------------------------------------------------------------

// CreateSandboxDialog is the new-sandbox modal. Form fields bind to Datastar
// signals; submit POSTs them to the dashboard API. Advanced options (ports,
// mounts, secrets, labels) live behind a disclosure so the common path stays
// two fields deep.
templ CreateSandboxDialog(m Meta) {
	if CanAdmin(ctx) {
		@dialog.Dialog(dialog.Props{ID: "create-sandbox"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl"}) {
				<div
					data-signals={ createSandboxSignals(m.DefaultImage) }
				>
					@dialog.Header() {
						@dialog.Title() {
							New sandbox
						}
						@dialog.Description() {
							Boot a new microVM from an OCI image.
						}
					}
					<div id="create-sandbox-error"></div>
					<form
						class="grid max-h-[65vh] gap-4 overflow-y-auto py-4 pr-1"
						data-on:submit="@post('/ui/sandboxes', {retry:'never'})"
						data-indicator="sbxbusy"
					>
						@field("sbximage", "Image") {
							@input.Input(input.Props{
								ID:          "sbximage",
								Placeholder: "microsandbox/python",
								Attributes:  templ.Attributes{"data-bind": "sbximage", "list": "img-options", "required": "true"},
							})
							<datalist id="img-options">
								for _, im := range m.Images {
									<option value={ im }></option>
								}
							</datalist>
						}
						<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
							@field("sbxcpu", "vCPU") {
								@input.Input(input.Props{ID: "sbxcpu", Type: "number", Attributes: templ.Attributes{"data-bind": "sbxcpu", "step": "0.5", "min": "0", "max": "255"}})
							}
							@field("sbxmemory", "Memory (MB)") {
								@input.Input(input.Props{ID: "sbxmemory", Type: "number", Attributes: templ.Attributes{"data-bind": "sbxmemory", "min": "0"}})
							}
							@field("sbxdisk", "Disk (GB)") {
								@input.Input(input.Props{ID: "sbxdisk", Type: "number", Attributes: templ.Attributes{"data-bind": "sbxdisk", "min": "0"}})
							}
							@field("sbxautostop", "Auto-stop (s)") {
								@input.Input(input.Props{ID: "sbxautostop", Type: "number", Attributes: templ.Attributes{"data-bind": "sbxautostop", "min": "0"}})
							}
						</div>
						@field("sbxworkdir", "Workdir (optional)") {
							@input.Input(input.Props{ID: "sbxworkdir", Placeholder: "/workspace", Attributes: templ.Attributes{"data-bind": "sbxworkdir"}})
						}
						@selectField("sbxnetwork", "Network policy", "sbxnetwork", []string{"", "none", "public-only", "allow-all", "non-local"})
						@field("sbxenv", "Env (KEY=VALUE per line)") {
							@textarea.Textarea(textarea.Props{ID: "sbxenv", Rows: 3, Placeholder: "FOO=bar", Attributes: templ.Attributes{"data-bind": "sbxenv"}})
						}
						<details class="rounded-md border p-3">
							<summary class="cursor-pointer text-sm font-medium">Advanced</summary>
							<div class="grid gap-4 pt-4">
								@field("sbxports", "Port forwards (host:guest per line)") {
									@textarea.Textarea(textarea.Props{ID: "sbxports", Rows: 2, Placeholder: "8080:80\n5432:5432/tcp", Attributes: templ.Attributes{"data-bind": "sbxports"}})
									@hint("Publishes a guest port on the msbd host.")
								}
								@field("sbxmounts", "Volume mounts (volume:/guest/path per line)") {
									@textarea.Textarea(textarea.Props{ID: "sbxmounts", Rows: 2, Placeholder: "my-data:/data", Attributes: templ.Attributes{"data-bind": "sbxmounts", "list": "vol-options"}})
									if len(m.Volumes) > 0 {
										@hint("Available volumes: " + joinMax(m.Volumes, 6))
									} else {
										@hint("No volumes yet — create one on the Volumes page first.")
									}
								}
								@field("sbxsecrets", "Secrets (KEY=VALUE per line)") {
									@textarea.Textarea(textarea.Props{ID: "sbxsecrets", Rows: 2, Placeholder: "API_TOKEN=…", Attributes: templ.Attributes{"data-bind": "sbxsecrets"}})
									@hint("Injected as guest env vars by the runtime; never logged.")
								}
								@field("sbxlabels", "Labels (KEY=VALUE per line)") {
									@textarea.Textarea(textarea.Props{ID: "sbxlabels", Rows: 2, Placeholder: "team=platform", Attributes: templ.Attributes{"data-bind": "sbxlabels"}})
								}
								<div class="grid grid-cols-2 gap-3">
									@field("sbxuser", "User") {
										@input.Input(input.Props{ID: "sbxuser", Placeholder: "root", Attributes: templ.Attributes{"data-bind": "sbxuser"}})
									}
									@field("sbxhostname", "Hostname") {
										@input.Input(input.Props{ID: "sbxhostname", Attributes: templ.Attributes{"data-bind": "sbxhostname"}})
									}
								</div>
							</div>
						</details>
					</form>
					@dialog.Footer() {
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
							Cancel
						}
						@button.Button(button.Props{
							Attributes: templ.Attributes{
								"data-on:click":  "@post('/ui/sandboxes', {retry:'never'})",
								"data-indicator": "sbxbusy",
								"data-attr":      "{disabled: $sbxbusy || !$sbximage}",
							},
						}) {
							@Busy("sbxbusy")
							Create
						}
					}
				</div>
			}
		}
	}
}

func createSandboxSignals(defaultImage string) string {
	return "{sbximage:" + jsExpr(defaultImage) + ", sbxcpu:1, sbxmemory:512, sbxdisk:0, sbxautostop:0," +
		" sbxworkdir:'', sbxnetwork:'', sbxenv:'', sbxports:'', sbxmounts:'', sbxsecrets:'', sbxlabels:''," +
		" sbxuser:'', sbxhostname:''}"
}

// ---------------------------------------------------------------------------
// Volumes / images / snapshots
// ---------------------------------------------------------------------------

// CreateVolumeDialog is the new-volume modal.
templ CreateVolumeDialog() {
	if CanAdmin(ctx) {
		@dialog.Dialog(dialog.Props{ID: "create-volume"}) {
			@dialog.Content() {
				<div data-signals="{volname:'', volkind:'dir', volsize:0, volquota:0, vollabels:''}">
					@dialog.Header() {
						@dialog.Title() {
							New volume
						}
						@dialog.Description() {
							Create a named persistent volume, then mount it when you create a sandbox.
						}
					}
					<div id="create-volume-error"></div>
					<form class="grid gap-4 py-4" data-on:submit="@post('/ui/volumes', {retry:'never'})" data-indicator="volbusy">
						@field("volname", "Name") {
							@input.Input(input.Props{ID: "volname", Placeholder: "my-data", Attributes: templ.Attributes{"data-bind": "volname", "required": "true"}})
						}
						@selectField("volkind", "Kind", "volkind", []string{"dir", "disk"})
						<div class="grid grid-cols-2 gap-3">
							@field("volsize", "Size (MB)") {
								@input.Input(input.Props{ID: "volsize", Type: "number", Attributes: templ.Attributes{"data-bind": "volsize", "min": "0"}})
								@hint("disk-backed volumes only")
							}
							@field("volquota", "Quota (MB)") {
								@input.Input(input.Props{ID: "volquota", Type: "number", Attributes: templ.Attributes{"data-bind": "volquota", "min": "0"}})
							}
						</div>
						@field("vollabels", "Labels (KEY=VALUE per line)") {
							@textarea.Textarea(textarea.Props{ID: "vollabels", Rows: 2, Attributes: templ.Attributes{"data-bind": "vollabels"}})
						}
					</form>
					@dialog.Footer() {
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
							Cancel
						}
						@button.Button(button.Props{
							Attributes: templ.Attributes{
								"data-on:click":  "@post('/ui/volumes', {retry:'never'})",
								"data-indicator": "volbusy",
								"data-attr":      "{disabled: $volbusy || !$volname}",
							},
						}) {
							@Busy("volbusy")
							Create
						}
					}
				</div>
			}
		}
	}
}

// PullImageDialog is the pull-image modal. The pull is long-running (it boots a
// throwaway microVM); the handler streams progress over the open SSE stream.
templ PullImageDialog(m Meta) {
	if CanAdmin(ctx) {
		@dialog.Dialog(dialog.Props{ID: "pull-image"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
				<div data-signals="{imgref:'', imgforce:false}">
					@dialog.Header() {
						@dialog.Title() {
							Pull image
						}
						@dialog.Description() {
							Fetch an OCI image into the local cache so sandboxes boot from it instantly.
						}
					}
					<div id="pull-image-error"></div>
					<form class="grid gap-4 py-4" data-on:submit="@post('/ui/images/pull', {retry:'never'})" data-indicator="pullbusy">
						@field("imgref", "Reference") {
							@input.Input(input.Props{
								ID:          "imgref",
								Class:       "font-mono",
								Placeholder: "microsandbox/python",
								Attributes:  templ.Attributes{"data-bind": "imgref", "required": "true", "list": "pull-suggestions", "autocomplete": "off"},
							})
							<datalist id="pull-suggestions">
								for _, sg := range pullSuggestions(m) {
									<option value={ sg }></option>
								}
							</datalist>
							@hint("Any OCI reference: repo, repo:tag, registry/repo:tag, or repo@sha256:… Untagged means :latest.")
						}
						<div class="flex flex-wrap gap-1.5">
							for _, sg := range starterImages() {
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Type: button.TypeButton, Class: "rounded-full border px-2.5 py-1 font-mono text-xs transition-colors hover:bg-accent", Attributes: templ.Attributes{"data-on:click": "$imgref = " + jsExpr(sg)}}) {
									{ sg }
								}
							}
						</div>
						<label class="flex items-start gap-2 text-sm" for="imgforce">
							@signalCheckbox("imgforce", "imgforce")
							<span>
								Force re-pull even if cached
								<span class="block text-xs text-muted-foreground">Without this, an already-cached reference is a no-op.</span>
							</span>
						</label>
						<!-- Moving tags are exactly where people expect "pull" to fetch a
						     newer copy; nudge them toward Force so it actually does. -->
						<p class="text-xs text-amber-500" data-show={ mutableTagExpr }>
							This is a moving tag. If it is already cached, tick Force to fetch a newer copy.
						</p>
					</form>
					@dialog.Footer() {
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
							Cancel
						}
						@button.Button(button.Props{
							Attributes: templ.Attributes{
								"data-on:click":  "@post('/ui/images/pull', {retry:'never'})",
								"data-indicator": "pullbusy",
								"data-attr":      "{disabled: $pullbusy || !$imgref}",
							},
						}) {
							@Busy("pullbusy")
							@icon.Download(icon.Props{Class: "size-4"})
							Pull
						}
					}
				</div>
			}
		}
	}
}

// mutableTagExpr is the client-side mirror of IsMutableTag: true when the typed
// reference is not digest-pinned and has no tag (implicit :latest) or :latest.
const mutableTagExpr = "!$imgforce && $imgref && !$imgref.includes('@') && " +
	"(!$imgref.split('/').pop().includes(':') || $imgref.endsWith(':latest'))"

// starterImages are the first-party sandbox images most people want, offered as
// one-click chips so a new user does not have to guess a reference.
func starterImages() []string {
	return []string{
		"microsandbox/python",
		"microsandbox/node",
		"microsandbox/command",
		"alpine:3",
		"debian:bookworm-slim",
	}
}

// pullSuggestions is the autocomplete list: the starter images plus everything
// already cached (handy for re-pulling a moving tag).
func pullSuggestions(m Meta) []string {
	seen := map[string]bool{}
	out := make([]string, 0, len(m.Images)+len(starterImages()))
	for _, s := range append(starterImages(), m.Images...) {
		if s != "" && !seen[s] {
			seen[s] = true
			out = append(out, s)
		}
	}
	return out
}

// CreateSnapshotDialog is the new-snapshot modal. The source is chosen from a
// real list of sandboxes rather than typed by hand.
templ CreateSnapshotDialog(sandboxes []SandboxRow, preselect string) {
	if CanAdmin(ctx) {
		@dialog.Dialog(dialog.Props{ID: "create-snapshot"}) {
			@dialog.Content() {
				<div data-signals={ "{snapsource:" + jsExpr(preselect) + ", snapname:'', snapforce:false}" }>
					@dialog.Header() {
						@dialog.Title() {
							New snapshot
						}
						@dialog.Description() {
							Capture a sandbox's rootfs. The sandbox should be stopped.
						}
					}
					<div id="create-snapshot-error"></div>
					<form class="grid gap-4 py-4" data-on:submit="@post('/ui/snapshots', {retry:'never'})" data-indicator="snapbusy">
						@field("snapsource", "Source sandbox") {
							if len(sandboxes) == 0 {
								@input.Input(input.Props{ID: "snapsource", Placeholder: "sbx_…", Attributes: templ.Attributes{"data-bind": "snapsource"}})
								@hint("No sandboxes found — create one first.")
							} else {
								@signalSelect("snapsource", "snapsource", sandboxSelectItems(sandboxes), "Select a sandbox…")
							}
						}
						@field("snapname", "Name (optional)") {
							@input.Input(input.Props{ID: "snapname", Placeholder: "my-snapshot", Attributes: templ.Attributes{"data-bind": "snapname"}})
						}
						<label class="flex items-center gap-2 text-sm" for="snapforce">
							@signalCheckbox("snapforce", "snapforce")
							Force (allow snapshotting a running sandbox)
						</label>
					</form>
					@dialog.Footer() {
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
							Cancel
						}
						@button.Button(button.Props{
							Attributes: templ.Attributes{
								"data-on:click":  "@post('/ui/snapshots', {retry:'never'})",
								"data-indicator": "snapbusy",
								"data-attr":      "{disabled: $snapbusy || !$snapsource}",
							},
						}) {
							@Busy("snapbusy")
							Create
						}
					}
				</div>
			}
		}
	}
}

// ImageDetailDialog shows the full OCI config + layer list for a cached image.
templ ImageDetailDialog(d ImageDetailView) {
	<div id="image-detail-slot">
		@dialog.Dialog(dialog.Props{ID: "image-detail"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl"}) {
				@dialog.Header() {
					@dialog.Title() {
						{ d.Reference }
					}
					@dialog.Description() {
						{ d.Architecture } / { d.OS } · { itoa(int(d.Layers)) } layers · { d.Size }
					}
				}
				<div class="max-h-[60vh] space-y-3 overflow-y-auto py-2 text-sm">
					@kv("Digest") {
						@Copyable("img-digest", ShortDigest(d.Digest), "text-xs")
					}
					@kv("Entrypoint") {
						<span class="font-mono text-xs">{ orDashS(d.Entrypoint) }</span>
					}
					@kv("Cmd") {
						<span class="font-mono text-xs">{ orDashS(d.Cmd) }</span>
					}
					@kv("Workdir") {
						<span class="font-mono text-xs">{ orDashS(d.WorkingDir) }</span>
					}
					@kv("User") {
						<span class="font-mono text-xs">{ orDashS(d.User) }</span>
					}
					@kv("Created") {
						@TimeAgo(d.CreatedAt)
					}
					@kv("Last used") {
						@TimeAgo(d.LastUsedAt)
					}
					if len(d.Env) > 0 {
						<div>
							<p class="mb-1 text-xs font-medium text-muted-foreground">Environment</p>
							<pre class="max-h-40 overflow-auto rounded bg-muted p-2 text-xs">{ joinLines(d.Env) }</pre>
						</div>
					}
					if len(d.LayerRows) > 0 {
						<div>
							<p class="mb-1 text-xs font-medium text-muted-foreground">Layers</p>
							<div class="divide-y rounded border">
								for _, l := range d.LayerRows {
									<div class="flex items-center gap-2 px-2 py-1 text-xs">
										<span class="flex-1 truncate font-mono">{ ShortDigest(l.Digest) }</span>
										<span class="text-muted-foreground">{ l.Size }</span>
									</div>
								}
							</div>
						</div>
					}
				</div>
				@dialog.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
						Close
					}
					if CanAdmin(ctx) {
						@button.Button(button.Props{
							Attributes: templ.Attributes{
								"data-on:click": "$sbximage=" + jsExpr(d.Reference) + ";" + closeDialogJS("image-detail") + openDialogJS("create-sandbox"),
							},
						}) {
							@icon.Play(icon.Props{Class: "size-4"})
							Launch sandbox
						}
					}
				}
			}
		}
	</div>
}

// closeDialogJS / openDialogJS drive shadcn-templ dialogs from a Datastar expression
// via the component's public window.templ.dialog API.
func closeDialogJS(id string) string {
	return "window.templ.dialog.close(" + jsExpr(id) + ");"
}

func openDialogJS(id string) string {
	return "window.templ.dialog.open(" + jsExpr(id) + ");"
}

// Numeric tail counts must remain numbers in the JSON sent to Go handlers.
func selectChange(bind, after string) string {
	value := "evt.detail.value"
	if bind == "logtail" {
		value = "Number(evt.detail.value)"
	}
	return "$" + bind + " = " + value + ";" + after
}

// Controlled checkboxes report detail.checked on the role=checkbox root;
// the hidden native input belongs to Base UI and is not data-bound separately.
// Datastar's module can initialize before the deferred component bundle. Sync
// again at window load, when deferred scripts have run, so an initial true
// signal is not left displaying the checkbox's false SSR default.
templ signalCheckbox(id, bind string) {
	@checkbox.Checkbox(checkbox.Props{ID: id, Checked: boolPtr(false), Attributes: templ.Attributes{
		"data-on:checkbox-change": "$" + bind + " = evt.detail.checked",
		"data-effect":             "const checked = $" + bind + "; window.templ && window.templ.checkbox && window.templ.checkbox.setChecked(el, checked)",
		"data-on:load__window":    "window.templ.checkbox.setChecked(el, $" + bind + ")",
	}})
}

func boolPtr(b bool) *bool { return &b }
