package views

import (
	"time"

	"github.com/mark3labs/msbd/internal/dashboard/components/alert"
	"github.com/mark3labs/msbd/internal/dashboard/components/checkbox"
	"github.com/mark3labs/msbd/internal/dashboard/components/copybutton"
	"github.com/mark3labs/msbd/internal/dashboard/components/dialog"
	"github.com/mark3labs/msbd/internal/dashboard/components/icon"
	"github.com/mark3labs/msbd/internal/dashboard/components/input"
	"github.com/mark3labs/msbd/internal/dashboard/components/label"
	"github.com/mark3labs/msbd/internal/dashboard/components/progress"
	"github.com/mark3labs/msbd/internal/dashboard/components/selectbox"
	"github.com/mark3labs/msbd/internal/dashboard/components/tabs"
	"github.com/mark3labs/msbd/internal/dashboard/components/toast"
	"github.com/mark3labs/msbd/internal/dashboard/components/tooltip"
)

// Meta carries shell-level info shown in the header.
type Meta struct {
	Version        string
	DefaultImage   string
	RuntimeVersion string
	SDKVersion     string
	Section        Section
	Title          string
	// Subtitle is an optional second line under the page title (used by the
	// sandbox detail page to show the sandbox id).
	Subtitle string
	// Images is the cached image inventory, offered as an autocomplete list in
	// the create-sandbox dialog.
	Images []string
	// Volumes is the named-volume inventory, offered in the mount picker.
	Volumes []string

	// ---- identity ----
	// Username is the signed-in account; empty when the dashboard runs open.
	Username string
	// Role is "admin" or "viewer".
	Role string
	// CanAdmin gates every mutating control in the UI. The server-side guards
	// are the real enforcement; hiding buttons just stops a viewer being offered
	// actions that would only 403.
	CanAdmin bool
	// ShowSettings gates the Settings nav (needs a state store AND admin).
	ShowSettings bool
	// CanSignOut is true in session mode, where signing out is meaningful.
	CanSignOut bool
}

// SignedIn reports whether a named account is driving this request.
func (m Meta) SignedIn() bool { return m.Username != "" }

// Page is the full HTML document: it loads the compiled CSS, the vendored
// Datastar runtime and the templui component scripts, then renders the app
// shell (sidebar + content region) around the given section body.
//
// Each section is a REAL page served at its own URL, so bookmarks, refresh and
// browser back/forward all work; Datastar SSE is used for in-page updates only.
templ Page(m Meta, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ pageTitle(m) }</title>
			<link rel="icon" href="/dashboard/assets/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/dashboard/assets/css/output.css"/>
			@themeBootScript()
			<script type="module" src="/dashboard/assets/vendor/datastar.js"></script>
			<script src="/dashboard/assets/js/metric-chart.js"></script>
			@checkbox.Script()
			@copybutton.Script()
			@dialog.Script()
			@input.Script()
			@label.Script()
			@progress.Script()
			@selectbox.Script()
			@tabs.Script()
			@toast.Script()
			@tooltip.Script()
		</head>
		<body class="bg-background text-foreground antialiased">
			<a
				href="#content"
				class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
			>Skip to content</a>
			<div class="flex h-screen w-full overflow-hidden" data-signals="{navopen:false}">
				@sidebar(m)
				<!-- Mobile scrim: closes the drawer when tapped. -->
				<div
					class="fixed inset-0 z-30 bg-black/50 md:hidden"
					data-show="$navopen"
					data-on:click="$navopen = false"
					aria-hidden="true"
				></div>
				<div class="flex min-w-0 flex-1 flex-col">
					@topbar(m)
					<main id="content" class="flex-1 overflow-y-auto p-4 sm:p-6" tabindex="-1">
						@body
					</main>
				</div>
			</div>
			@Toaster()
			@ConfirmDialog()
			if m.SignedIn() {
				@ChangePasswordDialog()
			}
		</body>
	</html>
}

// themeBootScript applies the persisted theme before first paint so there is no
// flash of the wrong palette. Defaults to the OS preference.
templ themeBootScript() {
	@templ.Raw(`<script>
(function () {
  function paint(t) {
    var dark = t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.dataset.theme = t;
    document.querySelectorAll("[data-theme-btn]").forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.themeBtn === t));
    });
  }
  var t = "system";
  try { t = localStorage.getItem("msbd-theme") || "system"; } catch (e) {}
  paint(t);
  window.msbdSetTheme = function (next) {
    try { localStorage.setItem("msbd-theme", next); } catch (e) {}
    paint(next);
  };
  // The buttons do not exist yet while this runs in <head>; sync them once the
  // document is parsed so the active theme is visibly pressed.
  document.addEventListener("DOMContentLoaded", function () {
    paint(document.documentElement.dataset.theme || "system");
  });
})();
</script>`)
}

// topbar is the mobile-only header: it exposes the drawer toggle and the page
// title, both of which the desktop layout renders elsewhere.
templ topbar(m Meta) {
	<header class="flex h-14 shrink-0 items-center gap-2 border-b px-4 md:hidden">
		<button
			type="button"
			class="inline-flex size-9 items-center justify-center rounded-md hover:bg-accent"
			aria-label="Open navigation"
			data-on:click="$navopen = true"
		>
			@icon.Menu(icon.Props{Class: "size-5"})
		</button>
		<span class="font-semibold">{ m.Title }</span>
	</header>
}

// sidebar is the persistent left navigation. On mobile it becomes an overlay
// drawer driven by the $navopen signal.
templ sidebar(m Meta) {
	<aside
		class="fixed inset-y-0 left-0 z-40 flex w-60 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground transition-transform md:static md:translate-x-0"
		data-class="{'-translate-x-full': !$navopen, 'translate-x-0': $navopen}"
		aria-label="Main navigation"
	>
		<div class="flex h-14 items-center gap-2 border-b px-4">
			<a href="/dashboard" class="flex items-center gap-2 font-semibold">
				@icon.Box(icon.Props{Class: "size-5"})
				msbd
			</a>
			<span class="ml-auto text-xs text-muted-foreground" title={ "msbd " + m.Version }>{ m.Version }</span>
			<button
				type="button"
				class="-mr-2 inline-flex size-8 items-center justify-center rounded-md hover:bg-accent md:hidden"
				aria-label="Close navigation"
				data-on:click="$navopen = false"
			>
				@icon.X(icon.Props{Class: "size-4"})
			</button>
		</div>
		<nav class="flex flex-col gap-1 p-2">
			@navItem(m, SectionOverview, "/dashboard", "layout-dashboard", "Overview")
			@navItem(m, SectionSandboxes, "/dashboard/sandboxes", "server", "Sandboxes")
			@navItem(m, SectionVolumes, "/dashboard/volumes", "hard-drive", "Volumes")
			@navItem(m, SectionImages, "/dashboard/images", "layers", "Images")
			@navItem(m, SectionSnapshots, "/dashboard/snapshots", "camera", "Snapshots")
			if m.ShowSettings {
				<div class="mt-2 px-3 pb-1 pt-2 text-xs font-medium text-muted-foreground/70 uppercase tracking-wide">Settings</div>
				@navItem(m, SectionKeys, "/dashboard/settings/keys", "key-round", "API keys")
				@navItem(m, SectionUsers, "/dashboard/settings/users", "users", "Users")
			}
		</nav>
		<div class="mt-auto space-y-2 border-t p-3 text-xs text-muted-foreground">
			@accountBox(m)
			@themeToggle()
			<div class="truncate" title={ "runtime " + m.RuntimeVersion }>runtime: { m.RuntimeVersion }</div>
			<div class="truncate" title={ "sdk " + m.SDKVersion }>sdk: { m.SDKVersion }</div>
			<a
				href="/docs"
				target="_blank"
				rel="noopener"
				class="inline-flex items-center gap-1 hover:text-foreground"
			>
				@icon.FileText(icon.Props{Class: "size-3.5"})
				API docs
			</a>
		</div>
	</aside>
}

// navItem is a real anchor so navigation is bookmarkable and back/forward work.
templ navItem(m Meta, sec Section, url, ico, lbl string) {
	<a
		href={ templ.SafeURL(url) }
		class={ "flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground", m.Section == sec),
			templ.KV("hover:bg-sidebar-accent/60", m.Section != sec) }
		if m.Section == sec {
			aria-current="page"
		}
	>
		@icon.Icon(ico)(icon.Props{Class: "size-4"})
		{ lbl }
	</a>
}

// themeToggle switches between system, light and dark palettes. It writes to
// localStorage via the boot script so the choice survives navigation.
templ themeToggle() {
	<div class="flex items-center gap-1" role="group" aria-label="Colour theme">
		@themeButton("system", "monitor", "Match system theme")
		@themeButton("light", "sun", "Light theme")
		@themeButton("dark", "moon", "Dark theme")
	</div>
}

templ themeButton(mode, ico, lbl string) {
	<button
		type="button"
		class="inline-flex size-7 items-center justify-center rounded-md hover:bg-accent hover:text-foreground aria-pressed:bg-accent aria-pressed:text-foreground"
		title={ lbl }
		aria-label={ lbl }
		aria-pressed="false"
		data-theme-btn={ mode }
		data-on:click={ "window.msbdSetTheme(" + jsExpr(mode) + ")" }
	>
		@icon.Icon(ico)(icon.Props{Class: "size-4"})
	</button>
}

func pageTitle(m Meta) string {
	if m.Title == "" {
		return "msbd"
	}
	return m.Title + " · msbd"
}

// accountBox is the signed-in identity block in the sidebar footer: who you
// are, how to change your password, and how to sign out. It renders nothing in
// open mode, where there is no account to speak of.
templ accountBox(m Meta) {
	if m.SignedIn() {
		<div class="space-y-1.5 pb-1">
			<div class="flex items-center gap-2">
				@icon.CircleUser(icon.Props{Class: "size-4 shrink-0"})
				<span class="truncate font-medium text-foreground" title={ m.Username }>{ m.Username }</span>
				if !m.CanAdmin {
					<span class="rounded bg-muted px-1.5 py-0.5 text-[10px] uppercase">read-only</span>
				}
			</div>
			<div class="flex items-center gap-3">
				<button
					type="button"
					class="hover:text-foreground"
					data-on:click={ openDialogJS("change-password") }
				>Change password</button>
				if m.CanSignOut {
					<form method="post" action="/dashboard/logout" class="contents">
						<button type="submit" class="hover:text-foreground">Sign out</button>
					</form>
				}
			</div>
		</div>
	}
}

// LoadingPanel is a neutral placeholder shown while a section loads.
templ LoadingPanel() {
	<div class="flex items-center gap-2 text-sm text-muted-foreground" role="status">
		@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
		Loading…
	</div>
}

// TableSkeleton is the shimmering placeholder shown while a table loads.
templ TableSkeleton(rows int) {
	<div class="space-y-2 p-4" role="status" aria-label="Loading">
		for range rows {
			<div class="h-8 w-full animate-pulse rounded bg-muted"></div>
		}
	</div>
}

// PageHeader renders a section title row with an optional action slot.
templ PageHeader(title string) {
	<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
		<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
		<div class="flex flex-wrap items-center gap-2">
			{ children... }
		</div>
	</div>
}

// Toaster is the live region transient toasts are appended into.
templ Toaster() {
	<div id="toaster" aria-live="polite" aria-atomic="false"></div>
}

// Notify renders a single toast. Handlers append it to #toaster over SSE; the
// templui toast script auto-shows it via its MutationObserver.
//
// Errors are STICKY (duration 0) so a long SDK message can actually be read and
// copied; successes auto-dismiss.
templ Notify(variant toast.Variant, title, desc string) {
	@toast.Toast(toast.Props{
		Variant:     variant,
		Title:       title,
		Description: desc,
		Position:    toast.PositionBottomRight,
		Duration:    toastDuration(variant),
		Dismissible: true,
		Icon:        true,
	})
}

// toastDuration keeps errors on screen until dismissed.
func toastDuration(v toast.Variant) int {
	if v == toast.VariantError {
		return 0
	}
	return 4000
}

// InlineError is the in-context error banner shown inside a panel or dialog,
// next to the control that failed, instead of only as a fleeting toast.
templ InlineError(id, title, msg string) {
	<div id={ id }>
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
			@icon.TriangleAlert(icon.Props{Class: "size-4"})
			@alert.Title() {
				{ title }
			}
			@alert.Description() {
				<span class="break-words whitespace-pre-wrap">{ msg }</span>
			}
		}
	</div>
}

// ClearInline empties an inline-error slot.
templ ClearInline(id string) {
	<div id={ id }></div>
}

// EmptyState is the friendly zero-data placeholder with a call to action.
templ EmptyState(ico, title, desc string) {
	<div class="flex flex-col items-center justify-center gap-3 px-6 py-12 text-center">
		<div class="rounded-full bg-muted p-3 text-muted-foreground">
			@icon.Icon(ico)(icon.Props{Class: "size-6"})
		</div>
		<div class="space-y-1">
			<p class="font-medium">{ title }</p>
			<p class="text-sm text-muted-foreground">{ desc }</p>
		</div>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

// Copyable renders a monospace value with a copy-to-clipboard button.
templ Copyable(id, value string, class string) {
	<span class="inline-flex items-center gap-1">
		<span id={ id } class={ "font-mono", class }>{ value }</span>
		@copybutton.CopyButton(copybutton.Props{TargetID: id, Class: "size-6 opacity-60 hover:opacity-100"})
	</span>
}

// TimeAgo renders a relative timestamp with the absolute value in the tooltip.
templ TimeAgo(t time.Time) {
	<span title={ AbsTime(t) }>{ RelTime(t) }</span>
}

// SearchBox is the shared client-side table filter. It binds the `q` signal,
// which each row's data-show expression matches against.
templ SearchBox(placeholder string) {
	<div class="relative w-full sm:w-64">
		<span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground">
			@icon.Search(icon.Props{Class: "size-4"})
		</span>
		<input
			type="search"
			class="h-9 w-full rounded-md border bg-background pl-8 pr-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring"
			placeholder={ placeholder }
			aria-label={ placeholder }
			data-bind="q"
		/>
	</div>
}

// SortHead is a sortable column header: it re-fetches the table fragment with
// the requested sort applied.
templ SortHead(base, col, lbl string, s TableSort) {
	<button
		type="button"
		class="-my-1 inline-flex min-h-6 items-center gap-1 py-1 font-medium hover:text-foreground"
		data-on:click={ "@get(" + jsExpr(base+s.Query(col)) + ")" }
		if s.Col == col {
			aria-sort={ ariaSort(s.Dir) }
		}
	>
		{ lbl }
		if a := s.Arrow(col); a != "" {
			<span aria-hidden="true">{ a }</span>
		}
	</button>
}

func ariaSort(dir string) string {
	if dir == "desc" {
		return "descending"
	}
	return "ascending"
}

// Busy renders the spinner shown inside a button while its request is in
// flight. Pair with data-indicator on the enclosing element.
templ Busy(signal string) {
	<span data-show={ "$" + signal } class="inline-flex" role="status" aria-label="Working">
		@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
	</span>
}
