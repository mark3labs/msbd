package views

import (
	"strings"

	"github.com/mark3labs/msbd/internal/dashboard/components/badge"
	"github.com/mark3labs/msbd/internal/dashboard/components/button"
	"github.com/mark3labs/msbd/internal/dashboard/components/card"
	"github.com/mark3labs/msbd/internal/dashboard/components/icon"
	"github.com/mark3labs/msbd/internal/dashboard/components/table"
)

// ImagesPage is the Images section: the local OCI image cache, plus the pull /
// re-pull / remove / prune management surface.
templ ImagesPage(m Meta, rows []ImageRow, s TableSort) {
	<div data-signals="{q:''}">
		@PageHeader("Images") {
			@SearchBox("Filter images…")
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"data-on:click":  "@get('/dashboard/api/images/table')",
					"data-indicator": "imgrefresh",
					"aria-label":     "Refresh image list",
				},
			}) {
				@Busy("imgrefresh")
				@icon.RefreshCw(icon.Props{Class: "size-4"})
				Refresh
			}
			@button.Button(button.Props{
				Variant: button.VariantSecondary,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"aria-label": "Prune unused images",
					"data-on:click": confirmAction(
						"Prune unused images?",
						"Removes every cached image, manifest and layer that no sandbox or snapshot references. Images still in use are kept. This cannot be undone, but anything removed can be pulled again.",
						"Prune",
						dsPost("/dashboard/api/images/prune"),
					),
				},
			}) {
				@icon.Trash(icon.Props{Class: "size-4"})
				Prune
			}
			@dialogOpenButton("pull-image", "Pull image")
		}
		<!-- Live progress for the in-flight pull (a cold pull boots a throwaway
		     microVM and can run for minutes, so it needs visible feedback). -->
		<div id="pull-progress"></div>
		@card.Card(card.Props{Class: "overflow-hidden"}) {
			@ImageTable(rows, s)
		}
		@PullImageDialog(m)
		@CreateSandboxDialog(m)
		<div id="image-detail-slot"></div>
	</div>
}

// ImageTable is the refreshable fragment.
templ ImageTable(rows []ImageRow, s TableSort) {
	<div id="img-table">
		if len(rows) == 0 {
			@EmptyState("layers", "No cached images", "Pull an OCI image so sandboxes can boot from it without a cold fetch.") {
				@dialogOpenButton("pull-image", "Pull image")
			}
		} else {
			<div class="flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2 text-xs text-muted-foreground">
				<span>{ itoa(len(rows)) } images · { totalImageSize(rows) } on disk</span>
				<span>Sandboxes boot instantly from a cached image; anything else is pulled on first use.</span>
			</div>
			<div class="overflow-x-auto">
				@table.Table() {
					<caption class="sr-only">Cached OCI images, { itoa(len(rows)) } total</caption>
					@table.Header() {
						@table.Row() {
							@table.Head() {
								@SortHead("/dashboard/api/images/table", "reference", "Reference", s)
							}
							@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
								Platform
							}
							@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
								Layers
							}
							@table.Head() {
								@SortHead("/dashboard/api/images/table", "size", "Size", s)
							}
							@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
								@SortHead("/dashboard/api/images/table", "used", "Last used", s)
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Actions
							}
						}
					}
					@table.Body() {
						for _, im := range rows {
							@table.Row(table.RowProps{Attributes: templ.Attributes{
								"data-show": textFilterExpr(im.Haystack()),
							}}) {
								@table.Cell(table.CellProps{Class: "max-w-[22rem] truncate font-mono text-xs"}) {
									<span title={ im.Reference }>{ im.Reference }</span>
									if im.InUse {
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-2"}) {
											in use
										}
									}
									if IsMutableTag(im.Reference) {
										<span
											class="ml-2 cursor-help text-[10px] text-amber-500"
											title="This is a moving tag — the registry copy may be newer than the cached one. Use Re-pull to update it."
										>moving tag</span>
									}
								}
								@table.Cell(table.CellProps{Class: "hidden text-xs whitespace-nowrap sm:table-cell"}) {
									{ im.Architecture } / { im.OS }
								}
								@table.Cell(table.CellProps{Class: "hidden text-xs md:table-cell"}) {
									{ itoa(int(im.Layers)) }
								}
								@table.Cell(table.CellProps{Class: "text-xs whitespace-nowrap"}) {
									{ im.Size }
								}
								@table.Cell(table.CellProps{Class: "hidden text-xs whitespace-nowrap sm:table-cell"}) {
									@TimeAgo(im.LastUsedAt)
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									<div class="flex items-center justify-end gap-1">
										@iconButton("Inspect "+im.Reference, "info",
											dsGet("/dashboard/api/images/inspect?ref="+queryVal(im.Reference)))
										@iconButton("Re-pull "+im.Reference+" (fetch the latest copy)", "refresh-cw",
											dsPost("/dashboard/api/images/pull?ref="+queryVal(im.Reference)+"&force=1"))
										@iconButton("Launch a sandbox from "+im.Reference, "circle-play",
											"$sbximage="+jsExpr(im.Reference)+";"+openDialogJS("create-sandbox"))
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeIcon,
											Class:   "size-8 text-destructive",
											Attributes: templ.Attributes{
												"title":      "Remove " + im.Reference,
												"aria-label": "Remove image " + im.Reference,
												"data-on:click": confirmAction(
													"Remove image?",
													removeImageBody(im),
													"Remove",
													dsDelete("/dashboard/api/images?ref="+queryVal(im.Reference)),
												),
											},
										}) {
											@icon.Trash2(icon.Props{Class: "size-4"})
										}
									</div>
								}
							}
						}
						@table.Row(table.RowProps{Attributes: templ.Attributes{"data-show": noMatchTextExpr(imageHaystacks(rows))}}) {
							@table.Cell(table.CellProps{Class: "text-muted-foreground", Attributes: templ.Attributes{"colspan": "6"}}) {
								No images match the current filter.
							}
						}
					}
				}
			</div>
		}
	</div>
}

// PullProgress is the live banner shown while an image is being fetched. The
// pull blocks on a throwaway microVM, so the handler streams elapsed time into
// this slot rather than leaving the user staring at nothing.
templ PullProgress(ref, elapsed string) {
	<div id="pull-progress" class="mb-4">
		@card.Card(card.Props{Class: "border-primary/40"}) {
			@card.Content(card.ContentProps{Class: "flex flex-wrap items-center gap-3 p-4"}) {
				@icon.LoaderCircle(icon.Props{Class: "size-4 shrink-0 animate-spin text-primary"})
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium">
						Pulling <span class="font-mono">{ ref }</span>
					</p>
					<p class="text-xs text-muted-foreground">
						Booting a throwaway microVM to fetch the image — this can take several minutes on a cold pull. You can keep using the dashboard; the pull continues in the background.
					</p>
				</div>
				<span class="text-xs tabular-nums text-muted-foreground" aria-live="polite">{ elapsed }</span>
			}
		}
	</div>
}

// PullDone clears the progress slot.
templ PullDone() {
	<div id="pull-progress"></div>
}

// removeImageBody explains the blast radius of removing one cached image.
func removeImageBody(im ImageRow) string {
	b := im.Reference + " will be deleted from the local cache"
	if im.Size != "" && im.Size != "—" {
		b += " (" + im.Size + " reclaimed)"
	}
	b += ". Running sandboxes are unaffected."
	if im.InUse {
		b += " A sandbox was booted from this image, so it will be re-pulled the next time one starts."
	} else {
		b += " It will be pulled again on next use."
	}
	return b
}

// IsMutableTag reports whether a reference points at a moving target — an
// explicit :latest, or no tag at all (which implies :latest). Those are the
// refs where a force re-pull actually does something, so the UI flags them.
// A digest-pinned reference is immutable by construction.
func IsMutableTag(ref string) bool {
	if strings.Contains(ref, "@") {
		return false // digest-pinned
	}
	// Strip any registry host:port before looking for a tag separator.
	name := ref
	if i := strings.LastIndex(ref, "/"); i >= 0 {
		name = ref[i+1:]
	}
	tag, hasTag := "", false
	if i := strings.LastIndex(name, ":"); i >= 0 {
		tag, hasTag = name[i+1:], true
	}
	return !hasTag || tag == "latest"
}

// totalImageSize sums the pre-formatted sizes back into a single figure. Sizes
// arrive as display strings, so the handler stashes the raw byte count too.
func totalImageSize(rows []ImageRow) string {
	var total uint64
	for _, r := range rows {
		total += r.SizeBytes
	}
	return HumanBytes(total)
}

func imageHaystacks(rows []ImageRow) []string {
	out := make([]string, 0, len(rows))
	for _, r := range rows {
		out = append(out, r.Haystack())
	}
	return out
}
